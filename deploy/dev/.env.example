# ============================================================
# 各服务访问清单（口令即下方同名变量的值）。把 <host> 换成宿主机地址。
# 本包只含基础服务；应用（server / transport / simulator / UI）在开发机的 IDE 中运行。
#
#  EMQX 控制台     http://<host>:${EMQX_DASHBOARD_PORT}   用户 admin -> EMQX_DASHBOARD_PASSWORD
#  InfluxDB 浏览器  http://<host>:${INFLUX_EXPLORER_PORT}  无需登录（admin 模式）
#  InfluxDB API    http://<host>:${INFLUX_PORT}           Bearer -> INFLUX_TOKEN
#  PostgreSQL      <host>:${POSTGRES_PORT}  库 conduit  用户 conduit -> POSTGRES_PASSWORD
#  Redis           <host>:${REDIS_PORT}     无口令
#  MQTT            <host>:${MQTT_PORT}      设备用各自的 deviceKey / deviceSecret
#
# POSTGRES_USER / POSTGRES_DB 固定为 conduit（写死在 compose 中），EMQX 控制台用户固定为 admin。
# ============================================================
# 开发环境包配置：复制为 .env 后修改。以下均为占位值，所有 change-me-* 都必须替换（例如 openssl rand -hex 32）。
POSTGRES_PASSWORD=change-me-postgres
# InfluxDB 3 管理员 token，必须以 apiv3_ 开头，其后只能含字母/数字/_/-（不要引号、反斜杠、$）；首次启动时写入库中，之后修改需删除 conduit_influx3-data 卷（见 README）
INFLUX_TOKEN=apiv3_change-me-influx-token
# InfluxDB 3 Explorer 会话签名密钥
INFLUX_EXPLORER_SESSION_KEY=change-me-explorer-session-key
# EMQX 控制台 admin 密码：仅在 emqx-data 卷为空（首次启动）时生效
EMQX_DASHBOARD_PASSWORD=change-me-emqx
# Broker 镜像，须与 deploy/standalone/.env.example 和测试镜像保持一致；5.10.5 的崩溃持久性限制见 docs/durability-validation.md。
EMQX_IMAGE=emqx/emqx:5.10.5
# EMQX 调用鉴权回调时携带的内部 token，必须与开发机上 server 的 conduit.internal.token 一致
CONDUIT_INTERNAL_TOKEN=change-me-internal-token
# 必填：EMQX 鉴权回调（开发机上 IDE 中运行的 conduit-server）的地址，<dev-host> 为宿主机访问开发机的地址；修改后需 docker compose up -d --force-recreate emqx
CONDUIT_AUTH_URL=http://<dev-host>:8080

# 端口绑定地址：应用在开发机上运行、要从其他机器连接这些端口，所以默认 0.0.0.0；只应在可信网络中使用，只供本机访问时改为 127.0.0.1
BIND_ADDR=0.0.0.0

# 宿主机端口
INFLUX_PORT=8096
# InfluxDB 3 Explorer（图形界面）
INFLUX_EXPLORER_PORT=8888
# PostgreSQL / Redis 对宿主机开放的端口，供 IDE 中运行的服务直连
POSTGRES_PORT=15432
REDIS_PORT=16379
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
# EMQX 单连接进程堆上限：持久会话恢复时默认 32MB 过小，仍保留有界保护。
EMQX_CONNECTION_MAX_HEAP_SIZE=256MB

# InfluxDB 查询容量（见 deploy/dev/docker-compose.yml 的注释）
# QUERY_FILE_LIMIT 决定单次查询能打开多少 parquet 文件，直接决定历史查询的最大可用跨度；
# 文件按 10 分钟切分（gen1-duration 只接受 1m/5m/10m，10m 已是最大），即 144 个/天，
# 30 天需要 4320 个，故默认 5000。MEM_LIMIT 防止长范围查询拖垮宿主机
INFLUX_QUERY_FILE_LIMIT=5000
INFLUX_MEM_LIMIT=3g
