# 开发环境包配置。复制为 .env 后按组修改；标注「必须改」的不要沿用示例值。
# 本包只跑基础服务，应用（server / transport / simulator / UI）在开发机的 IDE 中运行。
# 口令建议用随机串生成，例如：head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32

# ── 网络绑定与对外端口 ──────────────────────────────────────
# 应用在开发机上运行、要连这台宿主机的服务，所以默认开放到 0.0.0.0
BIND_ADDR=0.0.0.0
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
INFLUX_PORT=8096
INFLUX_EXPLORER_PORT=8888
POSTGRES_PORT=15432
REDIS_PORT=16379

# ── PostgreSQL ────────────────────────────────────────────
# 直连：<host>:${POSTGRES_PORT}
# 用户名与库名只在数据卷首次初始化时生效，之后再改会连不上已有数据
POSTGRES_USER=conduit
POSTGRES_DB=conduit
POSTGRES_PASSWORD=change-me-postgres                       # 必须改；同上，首次初始化后不可改

# ── Redis ─────────────────────────────────────────────────
# 直连：<host>:${REDIS_PORT}，未设口令（仅在受信网络内暴露）
# 承担上行总线、最新值、在线状态与 transport 选主；AOF 每次写入刷盘

# ── InfluxDB（时序库）──────────────────────────────────────
# API   http://<host>:${INFLUX_PORT}      鉴权：Bearer ${INFLUX_TOKEN}
# 浏览器 http://<host>:${INFLUX_EXPLORER_PORT}  admin 模式，打开即用，无需登录
INFLUX_TOKEN=apiv3_change-me-influx-token                  # 必须改，且必须以 apiv3_ 开头；首次初始化后不可改
INFLUX_EXPLORER_SESSION_KEY=change-me-explorer-session-key # 必须改；不设会导致每次重启都要重新进入页面
# 单次查询可打开的 parquet 文件数。文件按 10 分钟切分（144 个/天，gen1-duration 只接受 1m/5m/10m，
# 10m 已是最大，无法降低），所以这个值直接决定历史查询的最大跨度：30 天需要 4320 个。
# Core 默认 432 只够 3 天。再往上放大会显著抬高内存与延迟。
INFLUX_QUERY_FILE_LIMIT=5000
# 内存上限：长范围查询的内存随扫描文件数增长，不限制时一次失控查询会拖垮整台宿主机
INFLUX_MEM_LIMIT=2g
# 提示：Java 服务（server / transport / simulator）的 mem_limit 在独立部署包的 .env 中设置
# （SERVER_MEM_LIMIT 等）；原因是 MaxRAMPercentage 在容器无上限时按宿主机总内存计算。

# ── EMQX（MQTT 接入）───────────────────────────────────────
# 设备接入 <host>:${MQTT_PORT}，设备用各自的 deviceKey / deviceSecret
# 控制台   http://<host>:${EMQX_DASHBOARD_PORT}
EMQX_IMAGE=emqx/emqx:5.10.5
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-me-emqx                     # 必须改；首次启动后在控制台改密码会被重启覆盖回这里的值
# transport 读取会话指标用的只读 API key（EMQX 5 的 REST API 不接受控制台账号密码）
CONDUIT_EMQX_API_KEY=change-me-emqx-api-key                        # 必须改
CONDUIT_EMQX_API_SECRET=change-me-emqx-api-secret                  # 必须改
# transport 离线期间 EMQX 为它排队的最大条数。要覆盖主备切换窗口（约 17 秒）×峰值速率；
# 溢出按 mqueue_dropped 计数并告警。调大前先确认会话进程内存余量（见下一项）
EMQX_MAX_MQUEUE_LEN=100000
# 在途窗口：EMQX 最多允许多少条已投递未确认的消息。它同时限定了 transport 的攒批大小。
# 规则：transport 的 batch-size <= 本值，且本值应为 batch-size 的若干倍。相等时是停等协议
# （EMQX 发 N 条、等全部确认、再发 N 条，每批之间空一次完整往返）；窗口远大于批时，提交当前批的
# 同时下一批已在途，流水线深度为 窗口/批。实测 1024/64 约 4000 条/秒，32/32 约 2600 条/秒。
# 必须显著小于 EMQX 的 force_shutdown.max_mailbox_size（默认 1000）——在途消息堆在连接进程的 Erlang 信箱里，超过该上限会触发 mailbox_overflow 强杀（2026-10-28 实测：配 1024 时负载下必然被杀）
EMQX_MAX_INFLIGHT=512
# transport 攒批写入总线的批大小：不得大于上面的 EMQX_MAX_INFLIGHT（否则批永远攒不满、
# 每批白等满 batch-delay），也不要与之相等
TRANSPORT_BUS_BATCH_SIZE=64
TRANSPORT_BUS_BATCH_DELAY=5ms
# 单连接进程堆上限，实际按 1.5 倍触发（即 384MB）。mqueue 驻留在会话进程堆内，与本项共享上限。
# 独立部署包中 transport 的会话监控阈值（CONDUIT_TRANSPORT_MONITOR_HEAP_LIMIT）也取自本变量，两者始终一致。
EMQX_CONNECTION_MAX_HEAP_SIZE=256MB

# ── 与开发机上运行的应用对接 ────────────────────────────────
# EMQX 调用鉴权回调的地址，必须指向开发机上运行的 conduit-server（不是 localhost，容器里的 localhost 是它自己）
CONDUIT_AUTH_URL=http://<dev-host>:8080                    # 必须改为开发机地址
# EMQX 调用回调时带的 token；开发机的 application-local.yml 里要配同一个值
CONDUIT_INTERNAL_TOKEN=change-me-internal-token            # 必须改
# 开发机上的 transport 以这个身份连 EMQX（不是设备账号）
TRANSPORT_MQTT_USERNAME=conduit-transport
TRANSPORT_MQTT_PASSWORD=change-me-transport                # 必须改

# ── 性能观测栈（可选，compose profile「metrics」，默认不启动）─────────
# 启用：docker compose --profile metrics up -d。Prometheus + Grafana + node-exporter + redis-exporter 共 4 个容器，
# 合计内存上限约 896m（512m+256m+64m+64m），需预先导入 4 个镜像；宿主机内存紧张时先确认余量。
# cadvisor（容器 CPU/内存曲线，192m，镜像在 gcr.io）另放在 profile「metrics-cadvisor」，需额外加 --profile metrics-cadvisor 并多导入 1 个镜像。
# Grafana 控制台 http://<host>:${GRAFANA_PORT}，面板「Conduit 性能瓶颈观测」已预置；不开放匿名访问。
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana                   # 启用监控栈前必须改；留空时 Grafana 容器拒绝启动
# Prometheus 没有登录页，其端口默认只绑本机（不跟随 BIND_ADDR）；看面板走 Grafana。确需从别的机器直连时显式改成 0.0.0.0
PROMETHEUS_BIND_ADDR=127.0.0.1
PROMETHEUS_PORT=9090
# 数据保留期与磁盘上限，取先到者（压测机磁盘小，别设太大）
PROMETHEUS_RETENTION=7d
PROMETHEUS_RETENTION_SIZE=2GB
