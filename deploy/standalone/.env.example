# 独立部署包配置（单一 .env，含基础服务与应用的全部变量）：复制为 .env 后修改。
# 以下均为占位值，所有 change-me-* 都必须在宿主机可被他人访问之前替换（例如 openssl rand -hex 32）。

# 应用镜像的产物来源：prebuilt（默认，用 artifacts/ 中由 deploy/package.sh 打好的产物，宿主机无需外网）
# 或 source（在宿主机上从源码编译，需能访问 Maven 中央仓库与 npm 源）
BUILD_FROM=prebuilt

POSTGRES_PASSWORD=change-me-postgres
# InfluxDB 3 管理员 token，必须以 apiv3_ 开头，其后只能含字母/数字/_/-（不要引号、反斜杠、$）；首次启动时写入库中，之后修改需删除 conduit_influx3-data 卷（见本目录 README.md）
INFLUX_TOKEN=apiv3_change-me-influx-token
INFLUX_EXPLORER_SESSION_KEY=change-me-explorer-session-key
# EMQX 控制台 admin 密码：仅在 emqx-data 卷为空（首次启动）时生效
EMQX_DASHBOARD_PASSWORD=change-me-emqx
# 与开发环境包及端到端测试使用同一 Broker 版本
EMQX_IMAGE=emqx/emqx:5.10.5
CONDUIT_INTERNAL_TOKEN=change-me-internal-token
# 独立部署包中固定为容器内的 conduit-server，不要修改（compose 中 EMQX 也以此值覆盖；这一行用于满足基础服务定义的必填检查）
CONDUIT_AUTH_URL=http://conduit-server:8080

# 默认租户的租户管理员
CONDUIT_ADMIN_USERNAME=admin
# shadow：兼容观察；enforce：项目/站点授权；read-only：新授权范围内仅允许读取。
CONDUIT_AUTHORIZATION_MODE=shadow
# 两个 transport 必须使用同一固定 clientId；正常部署使用默认值，事故恢复改名须保留旧会话并记录。
TRANSPORT_CLIENT_ID=conduit-transport
CONDUIT_ADMIN_PASSWORD=change-me-admin
# 平台管理员（不属于任何租户，管理租户）：库中没有平台管理员时按此创建；密码留空则不创建（server 只打一条 WARN）
CONDUIT_PLATFORM_ADMIN_USERNAME=sysadmin
CONDUIT_PLATFORM_ADMIN_PASSWORD=change-me-platform-admin
CONDUIT_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
TRANSPORT_MQTT_USERNAME=conduit-transport
TRANSPORT_MQTT_PASSWORD=change-me-transport
PIPELINE_CLAIM_MIN_IDLE=60s

# 端口绑定地址：默认仅本机可访问；需被其他机器访问时改为 0.0.0.0，并确保网络可信
BIND_ADDR=127.0.0.1

# 宿主机端口
WEB_PORT=8090
API_PORT=8091
MAILPIT_PORT=8025
# 外部用户可打开的 Web 地址，用于邮件邀请链接；VM 演示需改成 VM 的可访问地址。
CONDUIT_PUBLIC_URL=http://localhost:8090
# 默认发到本包 Mailpit；接正式 SMTP 时设置以下变量并移除 mailpit 服务。
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=demo@conduit.local
# SMTP_USERNAME=
# SMTP_PASSWORD=
INFLUX_PORT=8096
# InfluxDB 3 Explorer（图形界面）
INFLUX_EXPLORER_PORT=8888
POSTGRES_PORT=15432
REDIS_PORT=16379
# MQTT 端口；BUILD_FROM=source 时也作为前端「连接信息」显示的端口（prebuilt 的前端在打包时已固定）
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083

# 演示模拟器（默认启动）
SIM_DEVICE_COUNT=100
SIM_INTERVAL_MS=10000
# 平台业务回执超时后原样重发；每台设备达到待确认上限后暂停产生新数据
SIM_ACK_TIMEOUT_MS=30000
SIM_MAX_PENDING=1000
# 模拟器上报格式：standard（标准 JSON）或 flat（扁平 JSON）；模拟器新建产品时按此选用解码器，已有产品不会被修改，需在产品详情中手动切换
SIM_PAYLOAD_FORMAT=standard
# 多租户模拟（V0.2-R）：默认复用 CONDUIT_PLATFORM_ADMIN_PASSWORD，模拟器启动后会发现 Flyway 预置的演示租户并模拟上报；
# 它会重置这些设备的密钥。仅需使用不同平台管理员口令时才设置 SIM_PLATFORM_PASSWORD
SIM_PLATFORM_USERNAME=sysadmin
# SIM_PLATFORM_PASSWORD=
# 逗号分隔的租户编码，* 表示全部启用中的租户
SIM_TENANTS=*
# 每个产品最多模拟的设备数
SIM_MAX_DEVICES_PER_PRODUCT=100
# EMQX 单连接进程堆上限；持久会话积压恢复需足够余量。
EMQX_CONNECTION_MAX_HEAP_SIZE=256MB

# InfluxDB 查询容量（见 deploy/dev/docker-compose.yml 的注释）
# QUERY_FILE_LIMIT 决定单次查询能打开多少 parquet 文件，直接决定历史查询的最大可用跨度；
# 文件按 10 分钟切分（gen1-duration 只接受 1m/5m/10m，10m 已是最大），即 144 个/天，
# 30 天需要 4320 个，故默认 5000。MEM_LIMIT 防止长范围查询拖垮宿主机
INFLUX_QUERY_FILE_LIMIT=5000
INFLUX_MEM_LIMIT=3g
