      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(emqx_messages_dropped[1m])",
          "legendFormat": "消息丢弃"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(emqx_delivery_dropped_queue_full[1m])",
          "legendFormat": "队列满丢弃（mqueue_dropped）"
        }
