    {
      "id": 1,
      "type": "row",
      "title": "1. 各跳速率对比：哪一跳先掉下来（① 接入 QPS / ④ 入库 TPS）",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "链路各跳速率（条/秒）：① 接入 QPS → ④ 入库 TPS",
      "description": "按链路顺序编号：① 接入 QPS 是 EMQX 接收并向设备 PUBACK 的速率，④ 入库 TPS 是真正写进 InfluxDB 的速率。\n**对外承诺能力只能用入库 TPS，不能用接入 QPS。** 过载时 EMQX 会先 PUBACK 再丢弃，不带消息 id 的设备拿到确认却丢了数据（2026-10-28 实测一轮丢弃 51,671 条）。\n① 与 ④ 的差值即当前被堆积或丢弃的量；若差值持续扩大，说明已超出稳态容量。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(emqx_messages_received[1m])",
          "legendFormat": "① 接入 QPS：EMQX 接收并确认"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(emqx_messages_delivered[1m])",
          "legendFormat": "EMQX 投递"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(redis_commands_total{cmd=\"xadd\"}[1m])",
          "legendFormat": "③ 写入总线：XADD"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(conduit_pipeline_processed_total{type=\"property\"}[1m]))",
          "legendFormat": "④ 入库 TPS：写进 InfluxDB"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(redis_stream_group_entries_read[1m])",
          "legendFormat": "消费组已读（Redis 侧，交叉验证）"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(conduit_transport_session_sent[1m])",
          "legendFormat": "② 投递：EMQX → transport"
        }
      ]
    },
