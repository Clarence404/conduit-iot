# Java / Maven
target/
*.class
__pycache__/

# Node
node_modules/
dist/

# IDE
.idea/*
!.idea/workspace.xml
.vscode/
*.iml

# Secrets
.env
deploy/dev/.env
deploy/standalone/.env
deploy/demo/.env.local

# 全量包的预编译产物（deploy/package.sh 在临时检出中生成），仓库里只保留占位文件
deploy/standalone/artifacts/*
!deploy/standalone/artifacts/.gitkeep

# OS
.DS_Store
Thumbs.db

# 本地 IDE 连接配置（含主机地址与口令，不入库）
application-local.yml
simulator-local.properties
.claude/worktrees/

# 服务日志目录（CONDUIT_LOG_DIR 默认值）
logs/

# 子智能体执行台账与中间产物（本地脚手架，不入库）
.superpowers/

# 压测工具的本地配置与设备密钥（含凭据，不入库）
docs/script/loadtest/config.json
docs/script/loadtest/devices.json

# Hive 多智能体工作台每次打开工作区自动生成的协作文件，不属于项目
.hive/
docs/script/loadtest/results/
