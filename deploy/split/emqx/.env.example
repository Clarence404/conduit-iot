# 拆分部署 · EMQX 主机的 .env。复制为 .env 后替换全部 change-me-*；口令必须与应用主机的 deploy/standalone/.env 一致。

# 设备与应用主机都要从别的机器连进来，所以对外监听
BIND_ADDR=0.0.0.0
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083

# ── 鉴权回调 ───────────────────────────────────────────────
# EMQX 每次设备连接都同步回调 conduit-server，所以这台主机必须能访问到应用主机上 server 的 API 端口（standalone 的 API_PORT）。
# 应用主机在 VMware NAT 后面时，EMQX 主机无法直连虚拟机：需在 VMware 的 NAT 设置里把宿主机端口转发到虚拟机，
# 这里填宿主机地址与转发端口，例如 http://<宿主机局域网地址>:8091
CONDUIT_AUTH_URL=http://<应用主机或其转发地址>:8091
# 与应用主机 .env 中的同名值相同：EMQX 回调 server 时携带
CONDUIT_INTERNAL_TOKEN=change-me-internal-token
# transport 读取会话指标、Prometheus 抓取 EMQX 指标用的只读 API key，与应用主机 .env 中的同名值相同
CONDUIT_EMQX_API_KEY=change-me-emqx-api-key
CONDUIT_EMQX_API_SECRET=change-me-emqx-api-secret

EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-me-emqx-dashboard

# ── 容量参数 ───────────────────────────────────────────────
# 下面四项是 2026-10-29 在 8 核压测 VM 上守恒判据验证过的组合（11,500 条/秒无损，见
# docs/test-reports/2026-10-29-vm-max-throughput.md），与仓库其他部署包的默认值（512 / 1000）不同。
# 约束：transport 的 TRANSPORT_BUS_BATCH_SIZE（应用主机 .env，配套取 512）≤ EMQX_MAX_INFLIGHT ≪ EMQX_MAX_MAILBOX_SIZE。
# 在途窗口：EMQX 推给 transport 每条连接、尚未确认的消息上限
EMQX_MAX_INFLIGHT=1024
# 连接进程信箱上限：在途消息堆在这里，必须显著大于在途窗口
EMQX_MAX_MAILBOX_SIZE=10000
# 每个会话的内存队列：覆盖 transport 主备切换窗口（约 17 秒）。驻留在连接进程堆内，调大前须确认堆余量
EMQX_MAX_MQUEUE_LEN=100000
# 单连接进程堆上限（实际按 1.5 倍触发）。是兜底保护，不要为塞下更大的队列去调高它
EMQX_CONNECTION_MAX_HEAP_SIZE=256MB

# ── 仅为通过 dev 文件的必填检查，本机不使用 ─────────────────────
# extends 会对整个 dev 文件做变量插值，其中 PostgreSQL / InfluxDB 的必填项在这台主机上用不到，填任意非空值即可
POSTGRES_PASSWORD=unused-on-emqx-host
INFLUX_TOKEN=unused-on-emqx-host
INFLUX_EXPLORER_SESSION_KEY=unused-on-emqx-host
