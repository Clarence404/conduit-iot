    {
      "id": 7,
      "type": "timeseries",
      "title": "EMQX 丢弃（条/秒）",
      "description": "队列满丢弃大于 0 即有数据丢失；指标名未经实际验证。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
