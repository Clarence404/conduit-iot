# 拆分部署 · EMQX 主机的 .env。复制为 .env 后替换全部 change-me-*；口令必须与应用主机的 deploy/standalone/.env 一致。

# 设备与应用主机都要从别的机器连进来，所以对外监听
BIND_ADDR=0.0.0.0
MQTT_PORT=1883
# 只供 transport 使用的内部监听器端口（设备连不上：server 只放行 transport）。拆分部署时防火墙只对应用主机放行
MQTT_INTERNAL_PORT=1884
EMQX_DASHBOARD_PORT=18083

# ── 鉴权回调 ───────────────────────────────────────────────
# EMQX 每次设备连接都同步回调 conduit-server，所以这台主机必须能访问到应用主机上 server 的 API 端口（standalone 的 API_PORT）。
# 应用主机在 VMware NAT 后面时，EMQX 主机无法直连虚拟机：需在 VMware 的 NAT 设置里把宿主机端口转发到虚拟机，
# 这里填宿主机地址与转发端口，例如 http://<宿主机局域网地址>:8091
CONDUIT_AUTH_URL=http://<应用主机或其转发地址>:8091
# 与应用主机 .env 中的同名值相同：EMQX 回调 server 时携带
CONDUIT_INTERNAL_TOKEN=change-me-internal-token
# transport 读取会话指标、Prometheus 抓取 EMQX 指标用的只读 API key，与应用主机 .env 中的同名值相同
CONDUIT_EMQX_API_KEY=change-me-emqx-api-key
CONDUIT_EMQX_API_SECRET=change-me-emqx-api-secret

EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-me-emqx-dashboard

# ── 容量参数（括号内为 EMQX 默认值）────────────────────────────────────
# 会话相关三项为有上限的取值（2026-11-12 所有者决定）：此前取最大值（窗口 65535、队列不限、不强杀）时，
# 过载积压把整台主机内存耗尽，EMQX 被系统杀掉两次、约 932 万条已确认消息丢失
# （docs/test-reports/2026-11-12-stress-to-failure.md）。窗口、信箱、堆沿用 2026-10-29 压测 VM 验证过的组合。
# 在途窗口：EMQX 推给每条连接、尚未确认的消息上限（默认 32）。
# 规则 TRANSPORT_BUS_BATCH_SIZE <= 本值 << EMQX_MAX_MAILBOX_SIZE：在途消息堆在连接进程信箱里，越过信箱上限即被强杀
EMQX_MAX_INFLIGHT=1024
# 每个会话的内存队列（默认 1000）。满了丢弃新消息并计入 mqueue_dropped；队列驻留在连接进程堆内，
# 与下面的堆上限共享内存。10 万条在 384MB（256MB×1.5）堆里放不下，过载时连接被强杀、积压整段丢失；
# 5 万条在过载时只按满丢弃、连接零强杀（2026-11-12 实测）。不得反过来上调堆上限
EMQX_MAX_MQUEUE_LEN=50000
# 按信箱 / 堆强杀单个连接（默认开启）。过载时只杀那一条连接、丢它的积压，EMQX 进程与其他连接不受影响
EMQX_FORCE_SHUTDOWN_ENABLE=true
EMQX_MAX_MAILBOX_SIZE=10000
# transport 专用 zone（内部监听器 tcp:internal，容器内 1884）：只放宽信箱与会话队列，堆上限与在途窗口仍用上面的全局值。
# 2026-11-16 断网补传实测：订阅连接信箱冲到 1.3 万～4.4 万被强杀、内存会话丢失；64 条连接 × 1.5 万条队列 ≈ 96 万条缓冲；调大 K（TRANSPORT_POOL_SIZE）时按 K × 单连接队列重新估算总缓冲
EMQX_TRANSPORT_MAX_MAILBOX_SIZE=200000
EMQX_TRANSPORT_MAX_MQUEUE_LEN=15000
# 共享订阅分发策略：round_robin 轮流投递、负载最均匀。下游不依赖顺序（最新值按 ts 比较、InfluxDB 幂等、在线状态有 since 守护）
EMQX_SHARED_SUBSCRIPTION_STRATEGY=round_robin
EMQX_CONNECTION_MAX_HEAP_SIZE=256MB
# 以下三项仍取最大值（2026-10-30 所有者要求），与会话积压无关。各值已用临时 EMQX 5.10.5 容器验证可启动且生效
# TCP 监听队列（默认 1024）与容器内核连接队列（默认 4096），大批设备同时重连时用
EMQX_TCP_BACKLOG=65535
EMQX_SOMAXCONN=65535
# 单个 MQTT 报文上限（默认 1MB，最大 256MB）
EMQX_MAX_PACKET_SIZE=256MB
# 容器内文件描述符上限固定为 1048576（dev 文件中设定，即 Linux 默认的单进程上限 nr_open），每条 MQTT 连接占一个

# ── 仅为通过 dev 文件的必填检查，本机不使用 ─────────────────────
# extends 会对整个 dev 文件做变量插值，其中 PostgreSQL / InfluxDB 的必填项在这台主机上用不到，填任意非空值即可
POSTGRES_PASSWORD=unused-on-emqx-host
INFLUX_TOKEN=unused-on-emqx-host
INFLUX_EXPLORER_SESSION_KEY=unused-on-emqx-host
